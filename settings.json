{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(npm *)",
      "Bash(pbcopy*)",
      "Read(**)",
      "Write(**)",
      "Write(~/.claude/.worktree-branch-override)",
      "Edit(**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(gh pr *)",
      "Bash(gh run view)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh api *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)",
      "mcp__serena__*",
      "mcp__sequential-thinking__*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*_token)",
      "Read(**/*_token.*)",
      "Read(**/.*token*)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/.*key*)",
      "Read(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Read(**/*secret*.json)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*secret*.xml)",
      "Read(**/*secret*.txt)",
      "Read(**/*secret*.cfg)",
      "Read(**/*secret*.ini)",
      "Read(**/*secret*.env)",
      "Read(**/.secret*)",
      "Read(**/*_secret)",
      "Read(**/*_secret.*)",
      "Read(**/secret_*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/*secret*.json)",
      "Write(**/*secret*.yaml)",
      "Write(**/*secret*.yml)",
      "Write(**/*secret*.xml)",
      "Write(**/*secret*.txt)",
      "Write(**/*secret*.cfg)",
      "Write(**/*secret*.ini)",
      "Write(**/*secret*.env)",
      "Write(**/.secret*)",
      "Write(**/*_secret)",
      "Write(**/*_secret.*)",
      "Write(**/secret_*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(**/*secret*.json)",
      "Edit(**/*secret*.yaml)",
      "Edit(**/*secret*.yml)",
      "Edit(**/*secret*.xml)",
      "Edit(**/*secret*.txt)",
      "Edit(**/*secret*.cfg)",
      "Edit(**/*secret*.ini)",
      "Edit(**/*secret*.env)",
      "Edit(**/.secret*)",
      "Edit(**/*_secret)",
      "Edit(**/*_secret.*)",
      "Edit(**/secret_*)",
      "Edit(**/*_token)",
      "Edit(**/*_token.*)",
      "Edit(**/.*token*)",
      "Edit(**/*_key)",
      "Edit(**/*_key.*)",
      "Edit(**/.*key*)",
      "Edit(**/*.pem)",
      "Edit(id_rsa)",
      "Edit(id_ed25519)"
    ],
    "ask": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(git merge *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *-XPOST*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *--method=PATCH*)",
      "Bash(gh api *--method=POST*)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.agent-memory"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | jq -r '.command // empty' | grep -qE '\\bgit\\s+rebase\\b'; then echo 'BLOCKED: git rebase はサンドボックスでドットファイル作成がブロックされ、rebase state が壊れます。git rebase / rebase --continue / rebase --abort はすべて「! git rebase <args>」でユーザーに実行を依頼してください。'; exit 2; fi; if echo \"$CLAUDE_TOOL_INPUT\" | jq -r '.command // empty' | grep -qE '\\bgh\\s+pr\\s+create\\b'; then ROOT=$(git rev-parse --show-toplevel 2>/dev/null); if [ -n \"$ROOT\" ]; then for TPL in \"$ROOT/.github/pull_request_template.md\" \"$ROOT/.github/PULL_REQUEST_TEMPLATE.md\" \"$ROOT/pull_request_template.md\" \"$ROOT/PULL_REQUEST_TEMPLATE.md\"; do if [ -f \"$TPL\" ]; then echo \"WARNING: PR テンプレートが見つかりました ($TPL)。以下に従って PR body を作成してください:\"; echo '---'; cat \"$TPL\"; echo '---'; exit 1; fi; done; fi; fi; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff & osascript -e 'display notification \"応答が完了しました\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-remove.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  }
}
