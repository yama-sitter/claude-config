{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(npm *)",
      "Bash(pbcopy*)",
      "Read(**)",
      "Edit(**)",
      "Read(~/.analyze/**)",
      "Edit(~/.analyze/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git ls-files *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(gh pr *)",
      "Bash(gh run view)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh api *)",
      "Bash(gh issue view *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)",
      "mcp__sequential-thinking__*",
      "mcp__plugin_context7_context7__*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*_token)",
      "Read(**/*_token.*)",
      "Read(**/.*token*)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/.*key*)",
      "Read(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Read(**/*secret*.json)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*secret*.xml)",
      "Read(**/*secret*.txt)",
      "Read(**/*secret*.cfg)",
      "Read(**/*secret*.ini)",
      "Read(**/*secret*.env)",
      "Read(**/.secret*)",
      "Read(**/*_secret)",
      "Read(**/*_secret.*)",
      "Read(**/secret_*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(**/*secret*.json)",
      "Edit(**/*secret*.yaml)",
      "Edit(**/*secret*.yml)",
      "Edit(**/*secret*.xml)",
      "Edit(**/*secret*.txt)",
      "Edit(**/*secret*.cfg)",
      "Edit(**/*secret*.ini)",
      "Edit(**/*secret*.env)",
      "Edit(**/.secret*)",
      "Edit(**/*_secret)",
      "Edit(**/*_secret.*)",
      "Edit(**/secret_*)",
      "Edit(**/*_token)",
      "Edit(**/*_token.*)",
      "Edit(**/.*token*)",
      "Edit(**/*_key)",
      "Edit(**/*_key.*)",
      "Edit(**/.*key*)",
      "Edit(**/*.pem)",
      "Edit(id_rsa)",
      "Edit(id_ed25519)"
    ],
    "ask": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(git merge *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *-XPOST*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *--method=PATCH*)",
      "Bash(gh api *--method=POST*)"
    ],
    "additionalDirectories": [
      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.agent-memory",
      "~/.analyze"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tree-preview-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-git-rebase.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-template-inject.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff & osascript -e 'display notification \"応答が完了しました\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-remove.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
