{
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*_token)",
      "Read(**/*_token.*)",
      "Read(**/.*token*)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/.*key*)",
      "Read(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Read(**/*secret*.json)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*secret*.xml)",
      "Read(**/*secret*.txt)",
      "Read(**/*secret*.cfg)",
      "Read(**/*secret*.ini)",
      "Read(**/*secret*.env)",
      "Read(**/.secret*)",
      "Read(**/*_secret)",
      "Read(**/*_secret.*)",
      "Read(**/secret_*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(**/*secret*.json)",
      "Edit(**/*secret*.yaml)",
      "Edit(**/*secret*.yml)",
      "Edit(**/*secret*.xml)",
      "Edit(**/*secret*.txt)",
      "Edit(**/*secret*.cfg)",
      "Edit(**/*secret*.ini)",
      "Edit(**/*secret*.env)",
      "Edit(**/.secret*)",
      "Edit(**/*_secret)",
      "Edit(**/*_secret.*)",
      "Edit(**/secret_*)",
      "Edit(**/*_token)",
      "Edit(**/*_token.*)",
      "Edit(**/.*token*)",
      "Edit(**/*_key)",
      "Edit(**/*_key.*)",
      "Edit(**/.*key*)",
      "Edit(**/*.pem)",
      "Edit(id_rsa)",
      "Edit(id_ed25519)"
    ],
    "ask": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(yarn install)",
      "Bash(yarn install *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.agent-memory",
      "~/.analyze"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tree-preview-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-git-rebase.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-git-stash-mutate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-git-commit-subst.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pr-template-guard.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-template-inject.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff & osascript -e 'display notification \"応答が完了しました\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-remove.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-bilingual-sync.sh"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["~/.config/gh/hosts.yml"]
    },
    "excludedCommands": ["git commit *"]
  },
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
